<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/padding_normal"
    android:layout_marginTop="@dimen/spacing_micro"
    android:layout_marginEnd="@dimen/padding_normal"
    android:layout_marginBottom="@dimen/spacing_micro"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="66dp"
    app:cardCornerRadius="@dimen/cardDefaultCornerRadius"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_normal">

        <FrameLayout
            android:id="@+id/recurringExpenseIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_category_expense_selected"
            android:padding="8dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/recurring_expense_title"
                android:src="@drawable/ic_recurring_expense_white" />
        </FrameLayout>

        <TextView
            android:id="@+id/recurringExpenseItemAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:textColor="@color/appTextColorPrimary"
            android:textSize="@dimen/app_text_size_normal"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/recurringExpenseItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_normal"
            android:layout_toEndOf="@id/recurringExpenseIcon"
            android:layout_toStartOf="@id/recurringExpenseItemAmount"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/appTextColorPrimary"
            android:textSize="@dimen/app_text_size_medium" />

        <TextView
            android:id="@+id/recurringExpenseItemDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/recurringExpenseItemName"
            android:layout_below="@id/recurringExpenseItemName"
            android:layout_marginTop="@dimen/spacing_micro"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/appTextColorSecondary"
            android:textSize="@dimen/app_text_size_small" />
    </RelativeLayout>
</android.support.v7.widget.CardView>
